    {
      "parameters": {
        "jsCode": "// Try to get snippet (summary text) or payload parts for full body\nlet emailText = $node[\"Gmail Trigger\"].json.snippet || \"\";\n\n// If payload.parts exist, try to get plain text part\nif ($node[\"Gmail Trigger\"].json.payload && $node[\"Gmail Trigger\"].json.payload.parts) {\n  const parts = $node[\"Gmail Trigger\"].json.payload.parts;\n  \n  for (const part of parts) {\n    if (part.mimeType === 'text/plain' && part.body && part.body.data) {\n      // Gmail API encodes body in base64url - decode it\n      const buff = Buffer.from(part.body.data, 'base64');\n      emailText = buff.toString('utf-8');\n      break;\n    }\n  }\n}\n\nconst summaryPrompt = `\nSummarize this customer inquiry in 3 sentences:\n\"${emailText.trim()}\"\n`;\n\nreturn [{ json: { summaryPrompt } }];\n"
      },
